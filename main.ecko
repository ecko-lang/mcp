# mcp - a Model Context Protocol client.
#
#   import mcp
#
#   s = mcp.connect(mcp.http_transport("https://example.com/mcp"))
#   for t in mcp.tools(s) { print(t.name) }
#   print(mcp.text_of(mcp.call_tool(s, "search", { query: "ecko" })))
#
# MCP is JSON-RPC 2.0 with a fixed vocabulary: a handshake, then tools,
# resources and prompts. This package speaks the HTTP transport; the transport
# is a value, so a stdio one drops in without touching the protocol layer.
#
# Needs the **net** capability for the HTTP transport, and none for a fake one.

# Selective on purpose. `fail`, `result_of`, `reply_for`, `is_notification`,
# `body_text` and `expects_reply` stay exported by their own files so sibling
# modules and the tests can reach them, but they are wire-protocol plumbing
# rather than API - a blanket `export *` would publish all six as `mcp.*`.
export { PROTOCOL_VERSION, request, notification, encode } from "./jsonrpc.ecko"
export { http_transport, fake, stdio_transport } from "./transport.ecko"
export * from "./client.ecko"
export * from "./server.ecko"
export * from "./serve.ecko"
