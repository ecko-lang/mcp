# JSON-RPC 2.0 framing, the wire format MCP speaks.
#
# Kept separate from the protocol layer because it has no opinion about MCP:
# it builds requests, reads replies, and turns a JSON-RPC error object into an
# Ecko error. Everything here is pure, so it tests without a server.
#
# `fail`, `bad_argument`, `result_of`, `reply_for`, `decode_message`,
# `outgoing_id` and `is_notification` are exported so sibling files and the
# tests can reach them; `main.ecko` does not re-export them, so they are not API.

import std.json

## The MCP protocol version this package speaks, in both directions.
##
## Shared rather than declared per side: a client and a server that disagree
## about it fail a handshake, and two constants drift the moment MCP revs.
export let PROTOCOL_VERSION = "2025-06-18"

# The error this package raises for a failure caused by the server or the wire.
# `kind` is always "mcp"; `reason` is the stable identifier a caller matches on.
export fn fail(reason, message, context = {}) {
    error(merge(context, { kind: "mcp", reason: reason, message: message }))
}

# A programmer mistake, raised at the boundary of the exported function `fname`.
export fn bad_argument(fname, message) {
    error({ kind: "bug", reason: "bad_argument", message: "mcp.{fname}: {message}" })
}

## Build a JSON-RPC request object. `id` correlates the reply; MCP requires it
## to be unique within a connection and never null.
##
## errors: `bug` when `id` is not a String or an Int, or `method` is not a String.
##
## example:
##   mcp.request(1, "tools/list")   # {id: 1, jsonrpc: 2.0, method: tools/list, params: {}}
export fn request(id, method, params = {}) {
    unless type_of(id) == "int" or type_of(id) == "string" {
        bad_argument("request", "id must be a String or an Int, got {type_of(id)}")
    }
    if type_of(method) != "string" {
        bad_argument("request", "method must be a String, got {type_of(method)}")
    }
    { jsonrpc: "2.0", id: id, method: method, params: params }
}

## Build a JSON-RPC notification: a request with no `id`, which the receiver
## must not reply to. MCP uses these for `notifications/initialized` and
## cancellation.
##
## errors: `bug` when `method` is not a String.
##
## example:
##   mcp.notification("notifications/initialized")
export fn notification(method, params = {}) {
    if type_of(method) != "string" {
        bad_argument("notification", "method must be a String, got {type_of(method)}")
    }
    { jsonrpc: "2.0", method: method, params: params }
}

## Encode a request or notification as JSON text for the wire.
##
## errors: `bug` when the message holds a value JSON cannot carry (a function).
##
## example:
##   mcp.encode(mcp.request(1, "ping"))   # {"id":1,"jsonrpc":"2.0","method":"ping","params":{}}
export fn encode(message) = json.encode(message)

# Decode one message from the wire, turning malformed text into an `mcp` error
# rather than a bare `parse` one: the server sent it, so it is a protocol fault.
export fn decode_message(text) {
    try {
        json.decode(text)
    } catch (e) {
        fail("bad_reply", "server sent text that is not JSON: {preview(text)}")
    }
}

# The `id` of an outgoing message, or null for a notification (or text that is
# not a JSON object, which no transport here produces).
export fn outgoing_id(text) {
    decoded = try { json.decode(text) } catch (e) { return null }
    if type_of(decoded) != "map" { return null }
    get(decoded, "id")
}

# A reply's `result`, raising its `error` object if the server sent one.
#
# A JSON-RPC error is a normal outcome of a well-formed call - an unknown tool,
# a bad argument - so it becomes an Ecko error carrying the server's own code
# and message rather than a generic failure.
export fn result_of(reply) {
    if type_of(reply) != "map" {
        fail("bad_reply", "server sent a reply that is not a JSON object")
    }
    if contains(keys(reply), "error") {
        e = reply["error"]
        code = if type_of(e) == "map" and contains(keys(e), "code") { e["code"] } else { 0 }
        msg = if type_of(e) == "map" and contains(keys(e), "message") {
            e["message"]
        } else {
            "unknown error"
        }
        fail("server_error", "server error {code}: {msg}", { code: code, detail: e })
    }
    unless contains(keys(reply), "result") {
        fail("bad_reply", "server reply has neither result nor error")
    }
    reply["result"]
}

# Decode a reply from wire text, checking it belongs to the request we sent.
#
# The id check is what makes a transport that can interleave messages safe:
# silently accepting the first object that arrives would attribute someone
# else's result, or a notification, to this call. The one reply allowed
# without our id is an error with `id: null`, which is how JSON-RPC answers a
# request the server could not even read.
export fn reply_for(id, text) {
    reply = decode_message(text)
    if type_of(reply) != "map" {
        fail("bad_reply", "server sent a reply that is not a JSON object")
    }
    if contains(keys(reply), "method") {
        fail(
            "bad_reply",
            "server sent a '{reply["method"]}' message where the reply to request {id} was expected",
        )
    }
    got = get(reply, "id")
    if is_null(got) {
        unless contains(keys(reply), "error") {
            fail("bad_reply", "server sent a reply with no id to request {id}")
        }
    } else if got != id { fail("id_mismatch", "reply id {got} does not match request id {id}") }
    result_of(reply)
}

# True when a decoded message is a notification rather than a reply - it has a
# method and no id.
export fn is_notification(message) = type_of(message) == "map" and
    contains(keys(message), "method") and
    not contains(keys(message), "id")

fn preview(text) {
    t = string(text)
    if len(t) > 80 { t[0..80] + "..." } else { t }
}
