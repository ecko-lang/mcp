# The server half. `handle` takes a decoded request and a declaration of what
# this server offers, and returns a reply map - so the whole protocol tests
# without a pipe or a socket, which is why the transports are thin.

import std.test
import std.json
import "../main.ecko"
import "../jsonrpc.ecko"
srv = main

fn tools() = [
    srv.tool("wc", "Count words", { type: "object" }, fn(a) len(split(trim(a.text), " "))),
    srv.tool(
        "boom",
        "Always fails",
        { type: "object" },
        fn(a) error({ kind: "x", message: "nope" }),
    ),
]

fn resources() = [
    srv.resource("memo://readme", "readme", "text/plain", fn() "the body"),
    srv.resource("memo://bad", "bad", "text/plain", fn() error({ kind: "x", message: "gone" })),
]

fn prompts() = [srv.prompt("review", "Review some code", [], fn(a) "review this: {a.code}")]

fn everything() = { tools: tools(), resources: resources(), prompts: prompts() }

fn mcp_session() {
    offered = everything()
    let transport = srv.fake(fn(request) {
        reply = srv.handle(request, offered, name: "loopback")
        if is_null(reply) { { jsonrpc: "2.0", id: null, result: {} } } else { reply }
    })
    srv.connect(transport)
}

fn req(id, method, params = {}) = { jsonrpc: "2.0", id: id, method: method, params: params }

# ------------------------------------------------------------------ handshake

test.case("initialize answers with the shared protocol version", fn() {
    # One constant for both directions: a client and a server that disagree
    # fail a handshake, and two declarations drift the moment MCP revs.
    r = srv.handle(req(1, "initialize"), tools(), name: "demo", version: "2.0")
    test.eq(r.result.protocolVersion, srv.PROTOCOL_VERSION)
    test.eq(r.result.serverInfo.name, "demo")
})

test.case("capabilities advertise only what is actually offered", fn() {
    # A client branches on this, so claiming a section with nothing in it
    # invites a call that can only answer method-not-found.
    only_tools = srv.handle(req(1, "initialize"), tools()).result.capabilities
    test.ok(not is_null(get(only_tools, "tools")), "tools advertised")
    test.ok(is_null(get(only_tools, "resources")), "resources not advertised")

    all = srv.handle(req(1, "initialize"), everything()).result.capabilities
    test.eq(len(sort(keys(all))), 3)
})

test.case("a bare list of tools is accepted as the whole offer", fn() {
    r = srv.handle(req(2, "tools/list"), tools())
    test.eq(len(r.result.tools), 2)
})

test.case("a notification gets no reply at all", fn() {
    # On stdio a spurious reply desynchronises a client reading line by line.
    r = srv.handle({ jsonrpc: "2.0", method: "notifications/initialized" }, tools())
    test.ok(is_null(r), "no reply for a notification")
})

test.case("ping is answered with an empty result", fn() {
    # Either side may ping to check the other is alive; the spec's answer is
    # `{}`, and "method not found" reads as a broken server.
    r = srv.handle(req(7, "ping"), tools())
    test.eq(r.id, 7)
    test.eq(r.result, {})
    test.ok(is_null(get(r, "error")), "no error")
})

# ---------------------------------------------------------------------- tools

test.case("tools/list returns the description and schema, never the handler", fn() {
    # The handler is an Ecko function: it would not encode as JSON, and it is
    # none of the client's business.
    r = srv.handle(req(2, "tools/list"), tools())
    test.eq(r.result.tools[0].name, "wc")
    test.ok(is_null(get(r.result.tools[0], "handler")), "handler is not in the reply")
})

test.case("tools/call runs the handler and wraps the result as content", fn() {
    r = srv.handle(req(3, "tools/call", { name: "wc", arguments: { text: "a b c" } }), tools())
    test.eq(r.result.content[0].text, "3")
})

test.case("a handler returning a content list is passed through unwrapped", fn() {
    t = [srv.tool("two", "", {}, fn(a) srv.text("x"))]
    r = srv.handle(req(1, "tools/call", { name: "two", arguments: {} }), t)
    test.eq(r.result.content[0].text, "x")
})

test.case("a crashed handler becomes a tool error, not a dead server", fn() {
    # The call succeeded and the tool failed. MCP models that as data so a model
    # can read why and try again, and the session survives.
    r = srv.handle(req(4, "tools/call", { name: "boom", arguments: {} }), tools())
    test.ok(is_null(get(r, "error")), "not a JSON-RPC error")
    test.ok(r.result.isError, "flagged as a tool error")
    test.ok(contains(r.result.content[0].text, "nope"), "carries the handler's message")
})

test.case("an unknown tool is a JSON-RPC error, not a tool error", fn() {
    # Reporting it as isError would tell the model its arguments were wrong.
    r = srv.handle(req(5, "tools/call", { name: "absent" }), tools())
    test.eq(r.error.code, -32602)
})

# ------------------------------------------------------------------ resources

test.case("resources/list returns uri, name and type but not the reader", fn() {
    r = srv.handle(req(1, "resources/list"), everything())
    test.eq(r.result.resources[0].uri, "memo://readme")
    test.ok(is_null(get(r.result.resources[0], "reader")), "reader is not in the reply")
})

test.case("resources/read runs the reader lazily", fn() {
    r = srv.handle(req(2, "resources/read", { uri: "memo://readme" }), everything())
    test.eq(r.result.contents[0].text, "the body")
    test.eq(r.result.contents[0].mimeType, "text/plain")
})

test.case("an unknown resource is refused", fn() {
    r = srv.handle(req(3, "resources/read", { uri: "memo://nope" }), everything())
    test.eq(r.error.code, -32602)
})

test.case("a reader that throws is a JSON-RPC error, not a tool error", fn() {
    # There is no isError for resources, so a failed read has to be an error.
    r = srv.handle(req(4, "resources/read", { uri: "memo://bad" }), everything())
    test.eq(r.error.code, -32603)
    test.ok(contains(r.error.message, "gone"), "carries the reader's message")
})

# -------------------------------------------------------------------- prompts

test.case("prompts/list returns the declarations", fn() {
    r = srv.handle(req(1, "prompts/list"), everything())
    test.eq(r.result.prompts[0].name, "review")
})

test.case("prompts/get renders a string into one user message", fn() {
    r = srv.handle(
        req(2, "prompts/get", { name: "review", arguments: { code: "x = 1" } }),
        everything(),
    )
    test.eq(r.result.messages[0].role, "user")
    test.ok(
        contains(r.result.messages[0].content.text, "x = 1"),
        "the argument reached the renderer",
    )
})

test.case("an unknown prompt is refused", fn() {
    r = srv.handle(req(3, "prompts/get", { name: "absent" }), everything())
    test.eq(r.error.code, -32602)
})

test.case("a section that was not offered answers method-not-found", fn() {
    r = srv.handle(req(1, "resources/list"), tools())
    test.eq(len(r.result.resources), 0)
})

# ------------------------------------------------------------------- the wire

test.case("handle_text decodes, answers and re-encodes", fn() {
    out = srv.handle_text(json.encode(req(1, "initialize")), tools())
    test.eq(json.decode(out).result.protocolVersion, srv.PROTOCOL_VERSION)
})

test.case("handle_text returns null for a notification", fn() {
    out = srv.handle_text(
        json.encode({ jsonrpc: "2.0", method: "notifications/initialized" }),
        tools(),
    )
    test.ok(is_null(out), "nothing to write")
})

test.case("malformed JSON is answered with a parse error, not thrown", fn() {
    # A client sending garbage gets -32700 back rather than taking the server
    # down with it.
    out = srv.handle_text("not json at all", tools())
    test.eq(json.decode(out).error.code, -32700)
})

test.case("an unknown method is method-not-found", fn() {
    r = srv.handle(req(6, "completion/complete"), everything())
    test.eq(r.error.code, -32601)
})

# ---------------------------------------------------- the two halves together

test.case("the client can read what the server writes", fn() {
    # The point of one package: the same jsonrpc.ecko frames both sides, so a
    # round trip through it is the strongest check that they agree.
    session = mcp_session()
    test.eq(srv.server_version(session), srv.PROTOCOL_VERSION)
    test.eq(map(srv.tools(session), fn(t) t.name), ["wc", "boom"])
    test.eq(srv.text_of(srv.call_tool(session, "wc", { text: "one two" })), "2")
})

# ----------------------------------------------------------------- pagination

## A server with more tools than fit one page.
fn many_tools(n) {
    mut out = []
    mut i = 0
    while i < n {
        out = push(out, srv.tool("t{i}", "tool {i}", { type: "object" }, fn(a) i))
        i = i + 1
    }
    out
}

test.case("a list longer than a page reports a next cursor", fn() {
    r = srv.handle(req(1, "tools/list"), many_tools(srv.PAGE_SIZE + 5))
    test.eq(len(r.result.tools), srv.PAGE_SIZE)
    test.ok(not is_null(get(r.result, "nextCursor")), "nextCursor is set")
})

test.case("the last page has no cursor", fn() {
    paged = many_tools(srv.PAGE_SIZE + 5)
    first = srv.handle(req(1, "tools/list"), paged)
    last = srv.handle(req(2, "tools/list", { cursor: first.result.nextCursor }), paged)
    test.eq(len(last.result.tools), 5)
    test.ok(is_null(get(last.result, "nextCursor")), "no cursor on the last page")
})

test.case("a list that fits one page carries no cursor", fn() {
    # A cursor that is always present would make a client loop forever.
    r = srv.handle(req(1, "tools/list"), many_tools(3))
    test.ok(is_null(get(r.result, "nextCursor")), "no cursor when it all fits")
})

test.case("a bad cursor is refused rather than silently clamped", fn() {
    r = srv.handle(req(1, "tools/list", { cursor: "99999" }), many_tools(3))
    test.eq(r.error.code, -32602)
    test.ok(contains(r.error.message, "cursor"), "names the problem")
})

test.case("a non-numeric or negative cursor is a -32602 reply, not a throw", fn() {
    # One client sending a cursor this server never issued used to kill the
    # whole stdio server with an uncaught int() error.
    for c in ["abc", "-1", "01", "1.5", 3] {
        for m in ["tools/list", "resources/list", "prompts/list"] {
            r = srv.handle(req(1, m, { cursor: c }), everything())
            test.eq(r.error.code, -32602)
        }
    }
})

test.case("the client follows cursors to the end of the list", fn() {
    # The bug this exists for: reading page one and stopping returns a short
    # list with nothing indicating it was truncated, so a model is never told
    # about the rest.
    offered = many_tools(srv.PAGE_SIZE + 42)
    session = srv.connect(srv.fake(fn(request) {
        r = srv.handle(request, offered, name: "paged")
        if is_null(r) { { jsonrpc: "2.0", id: null, result: {} } } else { r }
    }))
    test.eq(len(srv.tools(session)), srv.PAGE_SIZE + 42)
})

test.case("a server that repeats a cursor is stopped, not looped on", fn() {
    stuck = srv.fake(fn(request) {
        id = get(request, "id")
        if request.method == "initialize" {
            return { jsonrpc: "2.0", id: id, result: { protocolVersion: srv.PROTOCOL_VERSION } }
        }
        # Always the same cursor: a client that trusts it never terminates.
        { jsonrpc: "2.0", id: id, result: { tools: [], nextCursor: "same" } }
    })
    session = srv.connect(stuck)
    caught = try {
        srv.tools(session)
        "no error"
    } catch (e) { e.message }
    test.ok(contains(caught, "repeated"), "names the problem: {caught}")
})

# ------------------------------------------ cancellation, progress, staleness

test.case("cancel sends a notification, not a request", fn() {
    # There is nothing to wait for and no acknowledgement; an id here would make
    # the server try to reply to a cancellation.
    seen = cell([])
    session = srv.connect(srv.fake(fn(request) {
        cell_update(seen, fn(v) push(v, request))
        r = srv.handle(request, tools(), name: "t")
        if is_null(r) { { jsonrpc: "2.0", id: null, result: {} } } else { r }
    }))
    srv.cancel(session, 7, "user pressed stop")
    sent = cell_get(seen)
    last = sent[len(sent) - 1]
    test.eq(last.method, "notifications/cancelled")
    test.ok(is_null(get(last, "id")), "no id on a cancellation")
    test.eq(last.params.requestId, 7)
})

test.case("the id a call will use is knowable before sending it", fn() {
    # Cancelling needs the id up front, and `call` allocates it internally.
    seen = cell([])
    session = srv.connect(srv.fake(fn(request) {
        cell_update(seen, fn(v) push(v, request))
        r = srv.handle(request, tools(), name: "t")
        if is_null(r) { { jsonrpc: "2.0", id: null, result: {} } } else { r }
    }))
    expected = srv.next_request_id(session)
    srv.call(session, "tools/list")
    sent = cell_get(seen)
    test.eq(sent[len(sent) - 1].id, expected)
})

test.case("progress is skipped when the client did not ask for it", fn() {
    # No progressToken means nobody is listening; sending anyway is noise.
    test.ok(is_null(srv.progress(null, 1, 10)), "no token, no notification")
    p = srv.progress("tok", 3, 10)
    test.eq(p.method, "notifications/progress")
    test.eq(p.params.progress, 3)
    test.eq(p.params.total, 10)
})

test.case("progress_token reads the token out of a request", fn() {
    r = req(1, "tools/call", { name: "x" })
    test.ok(is_null(srv.progress_token(r)), "absent when not sent")
    with_token = {
        jsonrpc: "2.0",
        id: 1,
        method: "tools/call",
        params: { name: "x", _meta: { progressToken: "abc" } },
    }
    test.eq(srv.progress_token(with_token), "abc")
})

test.case("list-changed notifications carry no id", fn() {
    for n in [srv.tools_changed(), srv.resources_changed(), srv.prompts_changed()] {
        test.ok(is_null(get(n, "id")), "a notification has no id")
        test.ok(contains(n.method, "list_changed"), "names the change")
    }
})

# ------------------------------------------------------ the stdio transport

test.case("a request carries an id and a notification does not", fn() {
    # The whole reason a transport needs this distinction: reading after a
    # notification blocks until the timeout and then steals the *next*
    # response, which desynchronises every call after it.
    request = json.encode({ jsonrpc: "2.0", id: 1, method: "tools/list" })
    note = json.encode({ jsonrpc: "2.0", method: "notifications/initialized" })
    test.eq(jsonrpc.outgoing_id(request), 1)
    test.ok(is_null(jsonrpc.outgoing_id(note)), "a notification has no id")
})

# ------------------------------------------------- one bad request, one reply

test.case("a handler that throws a string becomes a tool error", fn() {
    t = [srv.tool("str", "", {}, fn(a) error("boom"))]
    r = srv.handle(req(1, "tools/call", { name: "str", arguments: {} }), t)
    test.ok(r.result.isError, "flagged as a tool error")
    test.ok(contains(r.result.content[0].text, "boom"), "carries the thrown string")
})

test.case("a reader or renderer that throws a string is -32603", fn() {
    offer = {
        resources: [srv.resource("memo://s", "s", "text/plain", fn() error("gone"))],
        prompts: [srv.prompt("p", "", [], fn(a) error("bad"))],
    }
    r = srv.handle(req(1, "resources/read", { uri: "memo://s" }), offer)
    test.eq(r.error.code, -32603)
    test.ok(contains(r.error.message, "gone"), "carries the thrown string")
    r2 = srv.handle(req(2, "prompts/get", { name: "p" }), offer)
    test.eq(r2.error.code, -32603)
})

test.case("a request that is not an object or has no method is -32600", fn() {
    test.eq(srv.handle([1], tools()).error.code, -32600)
    test.eq(srv.handle(5, tools()).error.code, -32600)
    test.eq(srv.handle({ jsonrpc: "2.0", id: 1 }, tools()).error.code, -32600)
    test.eq(srv.handle({ jsonrpc: "2.0", id: 1, method: 7 }, tools()).error.code, -32600)
    test.eq(srv.handle({ jsonrpc: "2.0", id: [1], method: "ping" }, tools()).error.code, -32600)
})

test.case("params or arguments of the wrong shape are -32602", fn() {
    test.eq(
        srv.handle({ jsonrpc: "2.0", id: 1, method: "ping", params: [1] }, tools()).error.code,
        -32602,
    )
    r = srv.handle(req(1, "tools/call", { name: "wc", arguments: "text" }), tools())
    test.eq(r.error.code, -32602)
})

test.case("a fault inside the server is -32603 and the server keeps answering", fn() {
    # A tool list holding something that is not a tool breaks tools/list.
    offer = { tools: ["not a tool"] }
    r = srv.handle(req(1, "tools/list"), offer)
    test.eq(r.error.code, -32603)
    test.eq(srv.handle(req(2, "ping"), offer).result, {})
})

test.case("handle_text answers anything with JSON and never throws", fn() {
    for text in [
        "[1]",
        "5",
        "null",
        r"""{"id":1}""",
        r"""{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{"cursor":"abc"}}""",
    ] {
        out = json.decode(srv.handle_text(text, tools()))
        test.ok(not is_null(get(out, "error")), "an error reply for {text}")
    }
})

test.case("a result that is not JSON is -32603, not a throw", fn() {
    t = [srv.tool("f", "", {}, fn(a) ({ content: [{ type: "text", text: fn() 1 }] }))]
    out = srv.handle_text(json.encode(req(9, "tools/call", { name: "f", arguments: {} })), t)
    test.eq(json.decode(out).error.code, -32603)
    test.eq(json.decode(out).id, 9)
})

test.case("declaring a tool with the wrong argument types is a bug", fn() {
    k = try { srv.tool("x", "d", {}, "not a function") } catch (e) { get(e, "kind") }
    test.eq(k, "bug")
    k2 = try { srv.handle(req(1, "ping"), "tools") } catch (e) { get(e, "reason") }
    test.eq(k2, "bad_argument")
})
